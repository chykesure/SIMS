generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SystemRole {
  ADMIN
  BURSAR
  TEACHER
  CLASS_TEACHER
  SUBJECT_TEACHER
  STAFF
}

// ==========================================
// CBT ENGINE (Computer-Based Testing)
// ==========================================

enum CbtQuestionType {
  MCQ
  TRUE_FALSE
}

enum CbtExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum CbtAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

// ==========================================
// ATTENDANCE ENGINE
// ==========================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceMode {
  MANUAL
  QR_TEACHER
  QR_STUDENT
}

enum AttendanceSessionStatus {
  ACTIVE
  CLOSED
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logo            String   @default("")
  address         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  website         String   @default("")
  motto           String   @default("")
  primaryColor    String   @default("#821329")
  state           String   @default("")
  country         String   @default("Nigeria")
  status          String   @default("pending") // pending, approved, rejected, suspended
  rejectionReason String   @default("")
  plan            String   @default("free") // free, basic, premium
  planStart       DateTime?
  planEnd         DateTime?
  maxStudents     Int      @default(50)
  maxUsers        Int      @default(3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]
  userRoles        UserRole[]
  students         Student[]
  teachers         Teacher[]
  subjects         Subject[]
  classes          Class[]
  sessions         Session[]
  examScores       ExamScore[]
  studentRecords   StudentRecord[]
  classPositions   ClassPosition[]
  subjectPositions SubjectPosition[]
  teacherRemarks   TeacherRemark[]
  principalRemarks PrincipalRemark[]
  teacherSignatures TeacherSignature[]
  principalSignatures PrincipalSignature[]
  resumptions      Resumption[]
  schoolSettings   SchoolSettings[]
  admissionRecords      AdmissionRecord[]
  loginHistories        LoginHistory[]
  activityLogs          ActivityLog[]
  feeTypes              FeeType[]
  feeAssignments        FeeAssignment[]
  payments              Payment[]
  incomeExpenses        IncomeExpense[]
  vouchers              Voucher[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  budgets               Budget[]
  budgetEntries         BudgetEntry[]
  classrooms            Classroom[]
  announcements         Announcement[]
  classroomAssignments  Assignment[]
  classroomSubmissions  Submission[]
  classroomMaterials    ClassMaterial[]
  planUpgradeRequests  PlanUpgradeRequest[]
  parents               Parent[]
  parentStudents        ParentStudent[]
  paymentEvidences      PaymentEvidence[]
  monthlyDues           MonthlyDue[]
  aiResources           AiResource[]
  teacherActivities     TeacherActivity[]
  lessonPlans           LessonPlan[]
  cbtQuestions          CbtQuestion[]
  cbtExams              CbtExam[]
  cbtExamQuestions      CbtExamQuestion[]
  cbtAttempts           CbtAttempt[]
  cbtAnswers            CbtAnswer[]
  attendanceSessions    AttendanceSession[]
  attendanceRecords     AttendanceRecord[]
  uploadedFiles         UploadedFile[]
}

// ==========================================
// PLAN UPGRADE REQUESTS
// ==========================================

model PlanUpgradeRequest {
  id          String   @id @default(cuid())
  tenantId    String
  tenantName  String   @default("")
  tenantEmail String   @default("")
  currentPlan String   // free, basic, premium
  requestedPlan String // basic, premium
  status      String   @default("pending") // pending, approved, rejected
  adminNote   String   @default("")
  reviewedBy  String   @default("")
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  action    String   // school_registered, school_approved, school_rejected, school_suspended, school_reactivated, plan_changed, login, etc
  details   String   @default("")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  password  String
  username  String
  role      String   @default("Staff") // Kept for backward compat (primary role)
  imageUrl  String   @default("")
  studentId String?
  teacherId String?
  parentId  String?
  resetCode String?
  resetCodeExpiry  DateTime?
  recoveryEmail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  loginHistory LoginHistory[]
  userRoles    UserRole[]   // NEW: flexible multi-role support

  @@unique([tenantId, email])
}

model UserRole {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      SystemRole
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, role]) // prevent duplicate role assignments
  @@index([tenantId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  userName  String
  email     String
  imageUrl  String   @default("")
  status    String   @default("login") // login, logout
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model Student {
  id             String   @id @default(cuid())
  tenantId       String
  regNo          String
  fullname       String
  gender         String
  dateOfBirth    String   @default("")
  class          String
  classRef       String   @default("")
  basic          String   @default("")
  department     String   @default("")
  parentNo       String   @default("")
  stateOfOrigin  String   @default("")
  lga            String   @default("")
  homeAddress    String   @default("")
  imageUrl       String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  parents  ParentStudent[]

  @@unique([tenantId, regNo])
}

model Teacher {
  id        String   @id @default(cuid())
  tenantId  String
  fullname  String
  subject   String   @default("")
  gender    String   @default("")
  phone     String   @default("")
  email     String   @default("")
  address   String   @default("")
  active    String   @default("Yes")
  imageUrl  String   @default("")
  recoveryEmail String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Subject {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  department String   @default("")   // e.g. "Science", "Art", "Commercial". Empty = all departments.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Class {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, title])
}

model Session {
  id         String   @id @default(cuid())
  tenantId   String
  sessionOne String
  sessionTwo String
  active     String   @default("No")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ExamScore {
  id        String   @id @default(cuid())
  tenantId  String
  session   String
  class     String
  term      String
  fullname  String
  subject   String
  firstCa   Float    @default(0)
  secondCa  Float    @default(0)
  thirdCa   Float    @default(0)
  exam      Float    @default(0)
  total     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model StudentRecord {
  id              String   @id @default(cuid())
  tenantId        String
  session         String
  class           String
  classRef        String   @default("")
  term            String
  fullname        String
  totalScore      Float    @default(0)
  average         Float    @default(0)
  percentage      Float    @default(0)
  attendance      Int      @default(0)
  subjectsTaken   Int      @default(0)
  subjectsPassed  Int      @default(0)
  subjectsFailed  Int      @default(0)
  classPosition   Int      @default(0)
  overallPosition Int      @default(0)
  totalStudents   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ClassPosition {
  id              String   @id @default(cuid())
  tenantId        String
  session         String
  class           String
  classRef        String   @default("")
  term            String
  fullname        String
  score           Float    @default(0)
  position        Int      @default(0)
  totalStudents   Int      @default(0)
  overallPosition Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SubjectPosition {
  id            String   @id @default(cuid())
  tenantId      String
  session       String
  class         String
  term          String
  fullname      String
  subject       String
  total         Float    @default(0)
  position      Int      @default(0)
  totalStudents Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TeacherRemark {
  id          String   @id @default(cuid())
  tenantId    String
  remark      String
  session     String?
  term        String?
  studentName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PrincipalRemark {
  id          String   @id @default(cuid())
  tenantId    String
  remark      String
  session     String?
  term        String?
  studentName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TeacherSignature {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   @default("")
  imageUrl  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PrincipalSignature {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   @default("")
  imageUrl  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Resumption {
  id            String   @id @default(cuid())
  tenantId      String
  session       String
  term          String
  openTerm      String   @default("")
  nextTerm      String   @default("")
  nextTermLabel String   @default("")
  noSchoolOpen  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SchoolSettings {
  id            String   @id @default(cuid())
  tenantId      String
  caCount       Int      @default(2)
  ca1Max        Int      @default(15)
  ca2Max        Int      @default(15)
  ca3Max        Int      @default(10)
  ca1Label      String   @default("1st CA")
  ca2Label      String   @default("2nd CA")
  ca3Label      String   @default("3rd CA")
  examMax       Int      @default(60)
  examLabel     String   @default("Exam")
  totalMax      Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AdmissionRecord {
  id              String   @id @default(cuid())
  tenantId        String
  fullname        String
  gender          String   @default("")
  dateOfBirth     String   @default("")
  parentName      String   @default("")
  parentPhone     String   @default("")
  parentEmail     String   @default("")
  address         String   @default("")
  previousSchool  String   @default("")
  desiredClass    String   @default("")
  status          String   @default("Pending")
  imageUrl        String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ==========================================
// FINANCE MODULE
// ==========================================

model FeeType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // e.g. "Tuition Fee", "Exam Fee", "Development Levy"
  description String   @default("")
  amount      Float    @default(0)
  frequency   String   @default("termly") // termly, session, once
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  assignments FeeAssignment[]
}

model FeeAssignment {
  id          String   @id @default(cuid())
  tenantId    String
  feeTypeId   String
  className   String   @default("") // "all" or specific class like "JSS1A"
  session     String   @default("")
  term        String   @default("") // empty = all terms
  amount      Float    @default(0) // override amount per assignment
  dueDate     String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  feeType  FeeType  @relation(fields: [feeTypeId], references: [id])
  payments Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  tenantId      String
  assignmentId  String
  studentId     String
  studentName   String
  studentRegNo  String   @default("")
  feeTypeName   String
  amount        Float    @default(0)
  method        String   @default("cash") // cash, bank_transfer, pos, cheque, online
  reference     String   @default("") // transaction reference
  term          String   @default("")
  session       String   @default("")
  paidBy        String   @default("") // name of person who paid
  note          String   @default("")
  status        String   @default("completed") // completed, partial, refunded
  receiptNo     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  assignment FeeAssignment  @relation(fields: [assignmentId], references: [id])
}

model IncomeExpense {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // income, expense
  category    String   // salary, maintenance, supplies, utility, donation, etc.
  description String   @default("")
  amount      Float    @default(0)
  date        String   @default("")
  reference   String   @default("")
  paidTo      String   @default("") // for expenses: who received
  receivedFrom String  @default("") // for income: who gave
  method      String   @default("cash") // cash, bank_transfer, pos, cheque
  term        String   @default("")
  session     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ==========================================
// VOUCHER MODULE
// ==========================================

model Voucher {
  id          String   @id @default(cuid())
  tenantId    String
  voucherNo   String   @unique
  type        String   // payment, receipt, credit_note, debit_note
  title       String   @default("")
  description String   @default("")
  amount      Float    @default(0)
  date        String   @default("")
  payeeName   String   @default("") // person being paid
  payeeDetails String  @default("")
  particulars String   @default("") // line item description
  authorizedBy String  @default("")
  status      String   @default("draft") // draft, approved, cancelled
  term        String   @default("")
  session     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ==========================================
// INVENTORY MODULE
// ==========================================

model InventoryItem {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  category    String   @default("") // stationery, furniture, lab_equipment, sports, cleaning, etc.
  description String   @default("")
  unit        String   @default("pcs") // pcs, pack, box, set, ream, etc.
  unitCost    Float    @default(0)
  quantity    Int      @default(0) // current stock
  reorderLevel Int     @default(5)
  location    String   @default("") // store room, lab, office, etc.
  supplier    String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  itemId      String
  type        String   // stock_in, stock_out, adjustment
  quantity    Int      @default(0)
  unitCost    Float    @default(0)
  totalCost   Float    @default(0)
  reason      String   @default("")
  reference   String   @default("")
  performedBy String   @default("")
  date        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  item   InventoryItem @relation(fields: [itemId], references: [id])
}

// ==========================================
// BUDGET MODULE
// ==========================================

model Budget {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  session     String
  term        String   @default("") // empty = full session
  totalBudget Float    @default(0)
  totalSpent  Float    @default(0)
  status      String   @default("draft") // draft, approved, active, closed
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  entries BudgetEntry[]
}

model BudgetEntry {
  id          String   @id @default(cuid())
  tenantId    String
  budgetId    String
  category    String   // salary, maintenance, supplies, utility, transport, etc.
  description String   @default("")
  allocated   Float    @default(0)
  spent       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id])
}

// ==========================================
// SECURITY MODULE
// ==========================================

model SecurityAuditLog {
  id          String   @id @default(cuid())
  tenantId    String   @default("platform")
  eventType   String
  severity    String   @default("info")
  ipAddress   String   @default("")
  userAgent   String   @default("")
  email       String   @default("")
  details     String   @default("")
  metadata    String   @default("")
  createdAt   DateTime @default(now())
}

// ==========================================
// GOOGLE CLASSROOM MODULE
// ==========================================

model Classroom {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String   @default("")
  section       String   @default("")
  subject       String   @default("")
  teacherId     String   @default("")
  teacherName   String   @default("")
  room          String   @default("")
  coverImage    String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  announcements Announcement[]
  assignments   Assignment[]
  materials     ClassMaterial[]
}

model Announcement {
  id            String   @id @default(cuid())
  tenantId      String
  classroomId   String
  title         String
  content       String   @default("")
  createdBy     String   @default("")
  createdByName String   @default("")
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
}

// ==========================================
// FILE UPLOADS (assignment attachments, photos, logos)
// Files are stored base64 in the DB and served via /api/files/[id]
// ==========================================

model UploadedFile {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String   @default("")
  size      Int      @default(0)
  data      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}


model Assignment {
  id            String   @id @default(cuid())
  tenantId      String
  classroomId   String
  title         String
  description   String   @default("")
  instructions  String   @default("")
  createdBy     String   @default("")
  createdByName String   @default("")
  dueDate       String   @default("")
  dueTime       String   @default("")
  maxScore      Int      @default(100)
  status        String   @default("active")
  attachmentUrl String   @default("")   // ← ADD THIS LINE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  classroom   Classroom   @relation(fields: [classroomId], references: [id])
  submissions Submission[]
}

model Submission {
  id            String    @id @default(cuid())
  tenantId      String
  assignmentId  String
  studentId     String
  studentName   String
  studentRegNo  String    @default("")
  content       String    @default("")
  attachmentUrl String    @default("")
  score         Float     @default(0)
  feedback      String    @default("")
  gradedBy      String    @default("")
  gradedByName  String    @default("")
  status        String    @default("submitted")
  submittedAt   DateTime  @default(now())
  gradedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])
}

model ClassMaterial {
  id              String   @id @default(cuid())
  tenantId        String
  classroomId     String
  title           String
  description     String   @default("")
  type            String   @default("link")
  url             String   @default("")
  fileSize        String   @default("")
  uploadedBy      String   @default("")
  uploadedByName  String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
}

// ==========================================
// PARENT MODULE
// ==========================================

model Parent {
  id         String   @id @default(cuid())
  tenantId   String
  fullname   String
  email      String   @default("")
  phone      String   @default("")
  address    String   @default("")
  occupation String   @default("")
  imageUrl   String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  students ParentStudent[]
}

model ParentStudent {
  id        String   @id @default(cuid())
  tenantId  String
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

// ==========================================
// PAYMENT EVIDENCE MODULE
// ==========================================

model PaymentEvidence {
  id              String   @id @default(cuid())
  tenantId        String
  tenantName      String   @default("")
  tenantEmail     String   @default("")
  type            String   @default("new_subscription") // new_subscription, renewal, upgrade
  targetPlan      String   @default("basic")
  amountUSD       Float    @default(0)
  amountNGN       Float    @default(0)
  fileName        String   @default("")
  fileSize        String   @default("0")
  fileType        String   @default("")
  fileData        String   @default("") // base64 encoded file
  reference       String   @default("")
  note            String   @default("")
  status          String   @default("pending") // pending, verified, rejected
  reviewedBy      String   @default("")
  reviewNote      String   @default("")
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  planKey      String   @unique // free, basic, premium
  name         String   // display name
  subtitle     String   @default("")
  priceUSD     Float    @default(0)
  priceNGN     Float    @default(0)
  monthlyDueNGN Float   @default(0) // Monthly maintenance fee
  priceLabel   String   @default("/session") // e.g. "/session", "/month", "forever"
  validityDays Int      @default(30) // how many days the plan lasts
  maxStudents  Int      @default(50)
  maxUsers     Int      @default(3)
  features     String   @default("[]") // JSON array of feature strings
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Previous Term Scores (for schools starting mid-session) ────────────────
// Allows teachers to manually enter student scores from terms before they
// started using SIMS, so cumulative averages are accurate.


model PreviousTermScore {
  id         String   @id @default(cuid())
  tenantId   String
  studentId  String
  classId    String
  subjectId  String
  session    String
  term       Int
  ca1        Float?
  ca2        Float?
  ca3        Float?
  exam       Float?
  totalScore Float
  remark     String?
  enteredBy  String?
  source     String?  // "csv-import" or "manual"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, studentId, classId, subjectId, session, term])
  @@index([tenantId, session, term, classId])
}
// ==========================================
// AI ASSISTANT MODULE
// ==========================================

model AiResource {
  id              String    @id @default(cuid())
  tenantId        String
  teacherId       String
  teacherName     String    @default("")
  title           String
  subject         String    @default("")
  className       String    @default("")
  topic           String    @default("")
  resourceType    String    @default("lesson-note")
  term            String    @default("")
  week            String    @default("")
  content         String    @db.Text
  status          String    @default("draft")
  publishedAt     DateTime?
  pointsAwarded   Int       @default(0)
  downloadCount   Int       @default(0)
  approvedBy      String?
  approvedByName  String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, teacherId])
  @@index([tenantId, status])
}

model TeacherActivity {
  id           String   @id @default(cuid())
  tenantId     String
  teacherId    String
  teacherName  String   @default("")
  action       String
  points       Int      @default(0)
  resourceId   String?
  details      String   @default("")
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, teacherId, createdAt])
}

model LessonPlan {
  id          String   @id @default(cuid())
  tenantId    String
  teacherId   String
  subject     String
  className   String
  term        String   @default("")
  session     String   @default("")
  weeks       String   @db.Text
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, teacherId])
}

// ==========================================
// MONTHLY MAINTENANCE DUES
// ==========================================

model MonthlyDue {
  id              String   @id @default(cuid())
  tenantId        String
  tenantName      String   @default("")
  month           String   // Format: "2025-08" (YYYY-MM)
  amount          Float    // Amount owed this month
  status          String   @default("unpaid") // unpaid, paid, overdue
  paidAt          DateTime?
  evidenceFileName String  @default("")
  evidenceFileData String  @default("") // base64 encoded
  evidenceFileSize String  @default("")
  evidenceFileType String  @default("")
  reference       String   @default("") // Transaction reference/teller number
  note            String   @default("")
  reviewedBy      String   @default("")
  reviewNote      String   @default("")
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month]) // One due per school per month
  @@index([tenantId, status])
  @@index([status])
}
// ==========================================
// CBT ENGINE (Computer-Based Testing)
// ==========================================

model CbtQuestion {
  id           String          @id @default(cuid())
  tenantId     String
  subject      String          // matches Subject.name
  class        String  @default("")   // class name string; "" = any class
  type         CbtQuestionType @default(MCQ)
  text         String
  image        String  @default("")   // optional image (future: image-based questions)
  options      Json            // ["2", "4", "6", "8"] — TRUE_FALSE uses ["True", "False"]
  correctIndex Int             // 0-based index into options
  marks        Int     @default(1)
  explanation  String  @default("")   // shown after submission (optional)
  createdBy    String  @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examLinks CbtExamQuestion[]

  @@index([tenantId, subject])
  @@index([tenantId, class])
}

model CbtExam {
  id               String         @id @default(cuid())
  tenantId         String
  title            String
  description      String @default("")
  subject          String
  class            String
  session          String         // e.g. "2025/2026"
  term             String         // e.g. "First Term"
  durationMinutes  Int
  questionCount    Int    @default(0)    // questions each student receives; 0 = all linked questions
  shuffleQuestions Boolean @default(true)
  shuffleOptions   Boolean @default(false)
  attemptsAllowed  Int    @default(1)
  startsAt         DateTime
  endsAt           DateTime
  status           CbtExamStatus @default(DRAFT)
  createdBy        String @default("")
  createdByName    String @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions CbtExamQuestion[]
  attempts  CbtAttempt[]

  @@index([tenantId, session, term])
  @@index([tenantId, class])
  @@index([tenantId, status])
}

model CbtExamQuestion {
  id         String @id @default(cuid())
  tenantId   String
  examId     String
  questionId String
  order      Int    @default(0)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam     CbtExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question CbtQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
}

model CbtAttempt {
  id            String           @id @default(cuid())
  tenantId      String
  examId        String
  studentId     String
  studentName   String @default("")     // denormalized for teacher views
  attemptNo     Int    @default(1)
  paper         Json                   // served questions WITHOUT answers: [{ id, text, type, options[], marks }]
  answerKey     Json                   // server-only: { [questionId]: { correctIndex, marks } }
  startedAt     DateTime @default(now())
  deadlineAt    DateTime               // server-enforced: startedAt + exam.durationMinutes
  submittedAt   DateTime?
  status        CbtAttemptStatus @default(IN_PROGRESS)
  autoSubmitted Boolean  @default(false)
  score         Float  @default(0)
  totalMarks    Float  @default(0)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam    CbtExam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers CbtAnswer[]

  @@unique([examId, studentId, attemptNo])
  @@index([tenantId, examId])
  @@index([tenantId, studentId])
}

model CbtAnswer {
  id            String  @id @default(cuid())
  tenantId      String
  attemptId     String
  questionId    String
  selectedIndex Int     @default(-1)   // -1 = unanswered
  isCorrect     Boolean @default(false)
  marksAwarded  Float   @default(0)
  answeredAt    DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempt CbtAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ==========================================
// ATTENDANCE ENGINE
// ==========================================

model AttendanceSession {
  id          String                  @id @default(cuid())
  tenantId    String
  class       String                          // class name string
  subject     String  @default("")            // "" = daily class register
  period      String  @default("")            // e.g. "1", "2"; "" = daily
  date        DateTime @db.Date
  mode        AttendanceMode          @default(MANUAL)
  status      AttendanceSessionStatus @default(ACTIVE)
  teacherId   String  @default("")            // Teacher.id
  teacherName String  @default("")
  secret      String  @default("")            // rotating-token secret (QR_STUDENT, Phase 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([tenantId, class, subject, period, date]) // one register per class/subject/period/day
  @@index([tenantId, class, date])
  @@index([tenantId, date])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  tenantId    String
  sessionId   String
  studentId   String
  studentName String @default("")
  status      AttendanceStatus @default(PRESENT)
  method      AttendanceMode   @default(MANUAL)
  markedBy    String @default("")      // userId of marker (teacher/self)
  markedAt    DateTime @default(now())

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId]) // one mark per student per session
  @@index([tenantId, sessionId])
  @@index([tenantId, studentId])
}